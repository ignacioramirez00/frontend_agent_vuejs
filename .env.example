
# Copiar este archivo a .env y completar con valores reales.
# .env está gitignoreado: los datos de usuario NO deben quedar en el repo.

# --- Sesión de prueba (se manda al backend en cada turno) ---
# VITE_SESSION_ID es el thread_id del checkpointer de LangGraph. En el frontend
# real es el UUID del usuario autenticado; acá se setea a mano porque el harness
# no tiene login. Con un valor que no sea un UUID real de la tabla public.user,
# todo el flujo funciona igual pero el POST final de creación de material falla
# a propósito (modo "dry": permite recorrer el wizard sin insertar filas).
VITE_SESSION_ID="00000000-0000-0000-0000-000000000000"

# --- userContext (solo se manda en los turnos type="init") ---
VITE_USER_CLIENT_CODE=""                     # código de cliente
VITE_USER_DIVISION_IDS="[]"                  # ids de división del usuario
VITE_USER_DIVISION_CODE=""
VITE_USER_DIVISION_NAME="Nombre Division"
VITE_USER_NAME="Nombre Apellido"
VITE_USER_EMAIL="usuario@ejemplo.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
